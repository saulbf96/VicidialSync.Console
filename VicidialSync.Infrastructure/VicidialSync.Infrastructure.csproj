<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="dbup-sqlserver" Version="7.2.0" />
    <PackageReference Include="MailKit" Version="5.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="11.0.0" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VicidialSync.Application\VicidialSync.Application.csproj" />
  </ItemGroup>

  <!-- Scripts SQL: viven fuera del repo y se meten dentro del .dll al compilar. -->
  <PropertyGroup>
    <CarpetaScripts Condition="'$(CarpetaScripts)' == ''">$(USERPROFILE)\Desktop\Trabajos\VOICES_VICIDIAL\SCRIPTS</CarpetaScripts>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(CarpetaScripts)\*.sql" LogicalName="Scripts.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Si no encuentra la carpeta, la compilación falla con un mensaje claro. -->
  <Target Name="ValidarCarpetaScripts" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(CarpetaScripts)')" Text="No se encontró la carpeta de scripts: $(CarpetaScripts)" />
  </Target>

</Project>
